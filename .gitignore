# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# uv
# uv.lock is committed intentionally

# Existing clones may still contain a large top-level dataset cache.
/datasets/

# experiment artifacts (中身は無視するが .gitkeep は残す)
projects/*/results/*
!**/results/.gitkeep
projects/*/data/*
!**/data/.gitkeep
projects/*/analysis/figures/*
!**/analysis/figures/.gitkeep

# env / secrets
.env

# OS
.DS_Store
